# Proveedor LLM: "local" (por defecto, servidor LLM en la LAN) | "groq" (nube)
# "ollama" se sigue aceptando como alias legacy de "local" por retrocompatibilidad.
LLM_PROVIDER=local

# Servidor LLM local — solo si LLM_PROVIDER=local
# El servidor confirmado es LM Studio (API OpenAI-compatible en /v1/...).
# Si en tu caso es Ollama, esta misma URL/API también funciona sin cambios de código.
OLLAMA_BASE_URL=http://192.168.1.133:1234
OLLAMA_MODEL=lmstudio-community/Meta-Llama-3.1-8B-Instruct-GGUF

# Groq — solo si LLM_PROVIDER=groq
GROQ_API_KEY=

# Tavily — búsqueda web para tool-use
TAVILY_API_KEY=
