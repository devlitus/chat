---
import SidebarHeader from './SidebarHeader.astro';
import NewChatButton from './NewChatButton.astro';
import SearchInput from './SearchInput.astro';
import ChatHistoryList from './ChatHistoryList.astro';
import UserProfile from './UserProfile.astro';
---
<aside class="sidebar">
	<SidebarHeader />
	<NewChatButton />
	<SearchInput />
	<ChatHistoryList />
	<UserProfile />
</aside>

<style>
	.sidebar {
		width: 320px;
		background: var(--color-sidebar);
		border-right: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		height: 100%;
	}
</style>
