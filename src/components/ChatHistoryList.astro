---
import ChatHistoryGroup from './ChatHistoryGroup.astro';
import ChatHistoryItem from './ChatHistoryItem.astro';
---
<div class="history-list">
	<ChatHistoryGroup label="Today">
		<ChatHistoryItem title="React Component Design" active />
		<ChatHistoryItem title="Debug Python Script" />
	</ChatHistoryGroup>
	<ChatHistoryGroup label="Yesterday">
		<ChatHistoryItem title="Marketing Copy Ideas" />
		<ChatHistoryItem title="Travel Itinerary Tokyo" />
		<ChatHistoryItem title="Gift Ideas for Mom" />
	</ChatHistoryGroup>
</div>

<style>
	.history-list {
		flex: 1;
		overflow-y: auto;
		padding: 8px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
</style>
