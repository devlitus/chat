<style is:global>
	:root {
		--color-primary: #2b8cee;
		--color-bg: #101922;
		--color-sidebar: #111a22;
		--color-border: #233648;
		--color-surface: #1c2936;
		--color-surface-hover: #253646;
		--color-text: #ffffff;
		--color-text-secondary: #94a3b8;
		--color-text-muted: #64748b;
	}

