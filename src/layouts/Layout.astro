		color: var(--color-text);
	}

	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: var(--color-border);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--color-primary);
	}

	::selection {
		background: rgba(43, 140, 238, 0.3);
