{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "nexus",
  "instructions": [
    ".agents/memory/session.md"
  ],
  "mcp": {
    "Astro docs": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": {}
    }
  },
  "lsp": true
}